# 生产环境变量模板
#
# 用法：
#   cp deploy/.env.production.example .env.production
#   编辑 .env.production 填入真实值
# 注意 --env-file：构建阶段要把 NEXT_PUBLIC_SITE_URL 内联进产物
# （sitemap.xml / robots.txt 依赖它），这个值来自 compose 的插值环境文件，
# 默认只读项目根目录的 .env，所以必须显式指定。
#   docker compose --env-file .env.production up -d --build
#
# 注意：.env.production 含密钥，已在 .gitignore 中排除，不要提交。

# ---------- 必填：安全相关 ----------
# JWT 签名密钥：务必改成随机长字符串，例如
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（秒），默认 7 天
JWT_EXPIRES=604800

# 管理员账号：首次执行种子（RUN_SEED=true）时创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run

# IP 哈希加盐：评论限频用，建议一并改成随机值
IP_HASH_SALT=change-me-too

# ---------- 站点 ----------
# 用于 sitemap.xml / robots.txt / canonical 链接，必须是真实对外域名
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------- 构建期软件源（只在 docker build 阶段用到，运行时不读） ----------
# 国内默认值已经调好，一般不用改。改完需要重新 --build 才生效。
#
# 腾讯云内网机器：APT_MIRROR 改成 mirrors.tencentyun.com 会更快（走内网）
# 海外机器：分别改回官方源
#   APT_MIRROR=deb.debian.org
#   NPM_REGISTRY=https://registry.npmjs.org
#   PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh
APT_MIRROR=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# ---------- 存储（compose 已设置，一般无需改动） ----------
DATABASE_URL=file:/data/db/blog.db
MEDIA_DIR=/data/media
SOFTWARE_DIR=/data/software

# ---------- 可调项 ----------
# 日志保留天数（默认 7）
LOG_RETENTION_DAYS=7
# 评论限频窗口（秒，默认 60）
COMMENT_RATE_LIMIT_SECONDS=60

# ip2region 离线库路径（镜像内已自带，一般无需改动）
IP2REGION_DB=./data/ip2region.db
IP2REGION_IPV6_DB=./data/ipv6wry.db

# ---------- 首次部署开关 ----------
# 首次部署设为 true：容器启动时会写入种子数据（含上面的管理员账号）。
# 初始化完成后建议改回 false，避免每次启动重复执行。
RUN_SEED=false
