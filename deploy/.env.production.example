# 生产环境变量模板
#
# 用法（仅全新部署；已有站点保留原 .env.production，禁止用模板覆盖）：
#   cp deploy/.env.production.example .env.production
#   编辑 .env.production 填入真实值
# 注意 --env-file：构建阶段要把 NEXT_PUBLIC_SITE_URL 内联进产物
# （sitemap.xml / robots.txt 依赖它），这个值来自 compose 的插值环境文件，
# 默认只读项目根目录的 .env，所以必须显式指定。
#   docker compose --env-file .env.production up -d --build
#
# 注意：.env.production 含密钥，已在 .gitignore 中排除，不要提交。

# ---------- 必填：安全相关 ----------
# JWT 签名密钥：必须是随机长字符串（≥32 字符）。
# ⚠️ 应用在生产环境会拒绝模板占位值（含 change-me / replace-with 等），
#    漏改会直接启动失败，这是有意的。
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（秒），默认 7 天
JWT_EXPIRES=604800
# 会话 Cookie 是否加 Secure 标记（可选，留空即自动判断）
#   留空  ：按实际请求协议自动判断（Nginx 透传 X-Forwarded-Proto）
#   true  ：始终加，只在确定全站 HTTPS 时使用
#   false ：始终不加
# 注意：用 http://IP 直接访问时若设成 true，浏览器会丢弃 Cookie，
# 表现为「登录接口 200 但页面跳不回后台」。
# SESSION_COOKIE_SECURE=

# 管理员账号：首次执行种子（RUN_SEED=true）时创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run

# IP 哈希加盐：评论限频 / 浏览量去重用，生产环境必填且不能是占位值。
# 缺失时评论与浏览量限频无法安全工作，应用会拒绝启动。
#   openssl rand -base64 32
IP_HASH_SALT=change-me-too

# ---------- 站点 ----------
# 用于 sitemap.xml / robots.txt / canonical 链接，必须是真实对外域名
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------- 构建期软件源（只在 docker build 阶段用到，运行时不读） ----------
# 国内默认值已经调好，一般不用改。改完需要重新 --build 才生效。
#
# 腾讯云内网机器：APT_MIRROR 改成 mirrors.tencentyun.com 会更快（走内网）
# 海外机器：分别改回官方源
#   APT_MIRROR=deb.debian.org
#   NPM_REGISTRY=https://registry.npmjs.org
#   PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh
APT_MIRROR=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# ---------- 数据卷（宿主机上的存放位置） ----------
# 数据库、媒体、软件包、备份都放在这一个宿主机目录里，容器内统一挂到 /data。
# 默认 /data。想放到项目下的 ./data 或另一块盘，就改成绝对路径，例如：
#   DATA_DIR=/www/blog-data
# 首次部署前为专用目录设置属主 1001:1001；不要对不明用途的已有目录递归改权限。
# 已部署站点必须保留原 DATA_DIR 与项目目录，先核对原 app 容器 /data 的 Mounts。
# 非当前绑定目录或路径不一致时停止，不能直接改路径、搬数据后启动；见 docs/更新手册.md。
# Compose 的 app.environment.DATA_DIR 固定为 /data；这里的 DATA_DIR 只选择宿主机挂载源。
# 升级冷备份另存数据目录之外，包含 WAL；scripts/backup.sh 不可作为可靠在线备份。
# DATA_DIR=/data

# ---------- 存储（容器内路径，compose 已设置，一般无需改动） ----------
DATABASE_URL=file:/data/db/blog.db
MEDIA_DIR=/data/media
SOFTWARE_DIR=/data/software
# 内容导出 / 导入的暂存目录（导入前的自动快照也存在这里）
BACKUP_DIR=/data/backups

# ---------- 可调项 ----------
# 日志保留天数（默认 7）
LOG_RETENTION_DAYS=7
# 评论限频窗口（秒，默认 60）
COMMENT_RATE_LIMIT_SECONDS=60

# ip2region 离线库路径（镜像内已自带，一般无需改动）
IP2REGION_DB=./data/ip2region.db
IP2REGION_IPV6_DB=./data/ipv6wry.db

# ---------- 首次部署开关 ----------
# 仅全新空库首次初始化时设为 true：创建管理员并写入示例数据。
# seed 会更新已有管理员密码、站点设置及同名示例内容，不是只补缺失记录。
# 初始化完成后必须改回 false 并重新 up -d 应用配置；已有站点升级始终使用 false。
RUN_SEED=false
