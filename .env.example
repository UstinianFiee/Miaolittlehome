# 复制为 .env.local 后使用。本文件仅占位值，禁止写入真实密钥。

# 数据库：开发为项目内 SQLite；生产为 file:/data/db/blog.db
DATABASE_URL="file:./dev.db"

# 媒体与软件安装包目录：开发为项目内目录；生产为 /data 挂载卷
MEDIA_DIR="./uploads"
SOFTWARE_DIR="./software"

# 站点公开地址（sitemap / Open Graph / 分享链接使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 认证（阶段 5 使用）
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES="7d"

# 管理员种子账号（阶段 4 种子数据 / 阶段 5 登录）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# 日志保留天数（阶段 15 使用）
LOG_RETENTION_DAYS="7"
