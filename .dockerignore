# Docker 构建上下文排除项
# 依赖与构建产物在镜像内重新生成，不进入上下文（否则上传极慢）

node_modules
.next
.git
.gitignore

# 环境变量（含密钥，绝不进镜像）
.env
.env.*
!.env.example
!deploy/.env.production.example

# 本地运行时数据（生产在 /data 卷）
uploads/*
!uploads/demo
software/*
!software/demo

# 开发期验证脚本与截图
.verify

# 编辑器与系统文件
.vscode
.idea
.DS_Store
Thumbs.db

# 文档（镜像内不需要；README 保留便于排查）
docs
*.md
!README.md

# 日志与临时文件
*.log
npm-debug.log*
.tmp
